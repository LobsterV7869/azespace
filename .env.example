# AzeSpace Discord Bot Environment Variables
# Copy this file to .env and replace the placeholder values with your actual keys.
# NEVER commit your actual .env file or share your token!

# Your Discord Bot Token (from Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Groq API Key for AI features (!ask command) (optional, from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Discord User ID of the Bot Owner for administrative commands (!givemoney, !removemoney)
OWNER_ID=819897775595454505
