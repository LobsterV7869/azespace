# Discord User-Installed App Configuration
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your .env file to Git!

# Discord Bot Token (used by deploy-commands.js to register global slash commands and for DM reminders)
DISCORD_TOKEN=your_bot_token_here

# Discord Application Client ID (from Discord Developer Portal -> General Information)
CLIENT_ID=your_application_client_id_here

# Discord Application Public Key (from Discord Developer Portal -> General Information -> PUBLIC KEY)
# Required to cryptographically verify incoming HTTP webhook requests from Discord
PUBLIC_KEY=your_application_public_key_here

# Port for Express HTTP interactions webhook server
PORT=3000
